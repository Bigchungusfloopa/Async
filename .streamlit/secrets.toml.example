# Copy to .streamlit/secrets.toml (gitignored) and fill in. Never commit real values.
SUPABASE_URL = "https://<project-ref>.supabase.co"
SUPABASE_KEY = ""            # publishable / anon key
GEMINI_API_KEYS = [""]
GROQ_API_KEYS = [""]
MISTRAL_API_KEYS = [""]

# Frontend: true = show the UI against data/mocks/*.json (UI development, no backend needed).
# Default / omitted = real engine + ML backend (which itself degrades gracefully offline).
USE_MOCKS = false
